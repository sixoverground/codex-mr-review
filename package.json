{
  "name": "codex-mr-review",
  "version": "0.2.2",
  "description": "Run the Codex CLI's review mode in GitLab CI and post findings to merge requests",
  "license": "MIT",
  "author": "Six Overground",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixoverground/codex-mr-review.git"
